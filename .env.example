# ============================================================
# GROUP-Devotion 部署設定範本
# 複製為 .env 並填入實際值，不要把 .env 提交到 git。
#
# 沒有填 SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY 之前，
# 這個 app 會自動退回記憶體內的示範資料，還是可以跑、可以看畫面，
# 只是重啟伺服器資料就會重置。
# ============================================================

# Flask
FLASK_SECRET_KEY=請換成一組長隨機字串（至少32字元）
# 設成 1 會多開放 /dev/login（本機測試用假登入，跳過 LINE），正式站不要開。
FLASK_DEBUG=0

# Supabase（先留空 = 記憶體示範模式）
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# LINE Login（先留空 = /login 會顯示「尚未設定」，其餘畫面照常可看）
LINE_CHANNEL_ID=YOUR_LINE_CHANNEL_ID
LINE_CHANNEL_SECRET=YOUR_LINE_CHANNEL_SECRET
LINE_REDIRECT_URI=https://YOUR_DOMAIN/line/callback

# 管理員／輔導（逗號分隔多個 LINE user ID）
# 首次部署時先留空並登入一次，畫面會顯示你的 LINE user ID，複製貼回這裡即可。
ADMIN_LINE_USER_IDS=

# 聖經互動書入口（沿用 bibile-actionbook 部署好的網站，點連結過去深度閱讀，
# 不是程式碼依賴。留空則不顯示連結。）
BIBLE_ACTIONBOOK_URL=https://web-production-68aee1.up.railway.app/
